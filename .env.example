# ============================================================
# PolicyMind 环境变量模板
# 用法：cp .env.example .env，再填写本机实际值
# .env 不入库；本文件只放占位符与安全默认值
# ============================================================

# ---------------- 运行环境 ----------------
APP_ENV=dev
LOG_LEVEL=INFO
TZ=Asia/Shanghai
API_HOST=0.0.0.0
API_PORT=8000

# ---------------- 大模型：DeepSeek ----------------
# 申请地址 https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 按账号实际开放的模型名填写
LLM_MODEL_MAIN=deepseek-v4-flash
LLM_MODEL_EXPERT=deepseek-v4-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---------------- Embedding：Ollama 本地 ----------------
# 前置：ollama pull nomic-embed-text && ollama serve
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60

# ---------------- Reranker：本地 HF 缓存 ----------------
# HF_HOME 改成你自己的缓存根目录（Windows 用正斜杠）
HF_HOME=G:/AI
# 模型已在本地缓存时设为 1，避免启动联网校验
HF_HUB_OFFLINE=1
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANK_TOP_K=6

# ---------------- 向量库：Chroma（Docker）----------------
# 宿主机端口避开 FastAPI 的 8000（本机实际部署映射见 docker-compose.yml）
CHROMA_MODE=http
CHROMA_HOST=localhost
CHROMA_PORT=8082
CHROMA_COLLECTION=policymind_clauses
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# ---------------- 关系库：MySQL（Docker）----------------
MYSQL_HOST=localhost
MYSQL_PORT=33307
MYSQL_DATABASE=policymind
MYSQL_USER=policymind
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql+pymysql://policymind:change-me@localhost:33307/policymind?charset=utf8mb4

# ---------------- 缓存 / Checkpointer：Redis ----------------
REDIS_URL=redis://localhost:6380/0
REDIS_KEY_PREFIX=policymind
# redis | sqlite（本地调试可用 sqlite，免依赖）
CHECKPOINT_BACKEND=redis
CHECKPOINT_TTL_SECONDS=604800

# ---------------- BM25 索引（本机内存）----------------
BM25_INDEX_PATH=data/index/bm25_index.pkl
BM25_TOP_K=10
BM25_K1=1.5
BM25_B=0.75
BM25_TOKENIZER=jieba
BM25_DICT_PATH=

# ---------------- 检索与编排参数 ----------------
RETRIEVAL_TOP_K=10
RRF_K=60
MAX_RETRIEVAL_LOOP=2
MAX_DISPATCH_ROUND=3
MAX_REVIEW_ROUND=1
GRADE_MIN_COVERAGE=0.6
CONTEXT_MAX_CHARS=6000
ENABLE_QUERY_REWRITE=true

# ---------------- 安全与服务 ----------------
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-32-byte-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MAX_UPLOAD_MB=50
# JSON 数组写法（也可用逗号分隔，config.py 兼容两种）
CORS_ORIGINS=["http://localhost:8000"]

# ---------------- 审核语义核查（可选，默认关闭：先纯规则）----------------
ENABLE_SEMANTIC_CHECK=false
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_THRESHOLD=0.45

# ---------------- 鉴权与上传 ----------------
# 登录系统开关：true 时所有业务接口需 Bearer JWT（注册/登录除外）
AUTH_ENABLED=true
UPLOAD_DIR=data/uploads

# ---------------- 日志与评估 ----------------
LOG_DIR=logs
LOG_ROTATION_MB=20
EVAL_DATASET_PATH=eval/dataset.jsonl
EVAL_REPORT_DIR=eval/reports

# ---------------- 预留：Neo4j（P8 扩展，默认关闭）----------------
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change-me
# ENABLE_GRAPH_RETRIEVAL=false
